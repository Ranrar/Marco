[Desktop Entry]
Version=1.0
Type=Application
Name=Polo
GenericName=Markdown Viewer
Comment=Polo is a fast and lightweight markdown viewer
Exec=markdownviewer %F
Icon=io.github.ranrar.Marco.Polo
Terminal=false
StartupNotify=true
StartupWMClass=io.github.ranrar.Marco.Polo
Categories=Office;Viewer;GTK;
Keywords=markdown;viewer;document;preview;
MimeType=text/markdown;text/x-markdown;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=markdownviewer
